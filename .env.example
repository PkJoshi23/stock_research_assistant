# Copy to .env and fill in real values. .env is gitignored - never commit it.
#   cp .env.example .env
#
# Only the DeepSeek key is required. News needs no key: ingestion uses Google
# News RSS and yfinance.

# --- DeepSeek (OpenAI-compatible API) ---------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# --- Ingestion universe -----------------------------------------------------
# Comma-separated tickers to load. Keep it small and well-connected.
WATCHLIST=AAPL,MSFT,NVDA,TSM,TSLA,GOOGL,AMD,INTC,AMZN,META,F

# --- SEC EDGAR --------------------------------------------------------------
# EDGAR needs no key, but it rejects requests whose User-Agent has no real
# contact address. Put your own address here; it is sent to sec.gov only.
SEC_COMPANY_NAME=graphbase-hackathon
SEC_CONTACT_EMAIL=you@example.com

# --- News ingestion (Google News RSS + yfinance; no API key) ----------------
NEWS_ITEMS_PER_TICKER=6
NEWS_TOP_K=5

# --- Embeddings -------------------------------------------------------------
# Changing the model means re-embedding every news node and rebuilding the index.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Agent behaviour --------------------------------------------------------
MAX_CYPHER_RETRIES=3
DEFAULT_RESULT_LIMIT=50
DEBUG_PROMPTS=false
