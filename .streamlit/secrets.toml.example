# Copy to .streamlit/secrets.toml for local runs that mimic Streamlit Cloud,
# or paste the same values into the Streamlit Cloud "Secrets" editor.
#
# On Cloud there is no .env file: src/config.py reads the environment first and
# falls back to st.secrets, so these two keys are all the app needs.

DEEPSEEK_API_KEY = "sk-your-deepseek-key"

# Only needed to crawl SEC filings (the graph is committed, so it is optional
# for running the deployed app).
SEC_CONTACT_EMAIL = "you@example.com"
